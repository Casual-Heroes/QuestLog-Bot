# WardenBot Environment Variables
# In production, place your actual values at /etc/casual-heroes/warden.env
# (owner: root, group: www-data, mode: 640)
# For local development, copy this file to .env and fill in your values.

# ─── Discord Bot ──────────────────────────────────────────────────────────────
# Get from: discord.com/developers/applications -> Your App -> Bot -> Token
WARDEN_BOT_TOKEN=

# Discord OAuth2 (for web dashboard login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://dashboard.yourdomain.com/auth/discord/callback

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
# Use Unix socket for local connections (faster and more reliable)
DB_SOCKET=/var/run/mysqld/mysqld.sock

# TCP connection (use instead of socket for remote MySQL)
#DB_HOST=localhost
#DB_PORT=3306

DB_USERNAME=
DB_PASSWORD=
DB_NAME=warden

# Show SQL queries in console? (only enable when debugging)
DB_ECHO=false

# ─── Django Web App Database (for shared models with ch-webserver) ────────────
DJANGO_DB_NAME=questlog_web
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306

# ─── Bot API Authentication ───────────────────────────────────────────────────
# Migration mode: accepts signed requests plus the legacy bearer token.
# Change to "signed" after ch-webserver is signing all requests.
WARDEN_API_AUTH_MODE=dual
# JSON public-key trust configuration generated by:
#   python scripts/generate_api_signing_key.py --key-id questlog-web-v1
WARDEN_API_TRUSTED_SIGNERS=
# Loopback-only, sync-only credential for the bot's internal scheduled jobs.
# Generate independently with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WARDEN_API_LOCAL_SYNC_TOKEN=
# Temporary migration credential. Remove after switching to signed mode.
DISCORD_BOT_API_TOKEN=

# Cross-platform bridge. Keep disabled unless Discord <-> Fluxer/Matrix relay
# is intentionally configured. A non-empty QUESTLOG_BOT_SECRET is also required.
ENABLE_BRIDGE=false
QUESTLOG_INTERNAL_API_URL=https://questlog.casual-heroes.com
QUESTLOG_BOT_SECRET=
# Extra HTTPS hosts permitted for bridge media downloads, comma-separated.
# The hosts from QUESTLOG_INTERNAL_API_URL, MATRIX_HOMESERVER and FLUXER_API_URL
# are included automatically.
BRIDGE_MEDIA_ALLOWED_HOSTS=

# QuestLog canonical LFG API. Generate this token once on the QuestLog server
# with scopes: lfg:read lfg:write lfg:act-as. Use the Token value beginning
# qlp_ here, not the Client value beginning qlc_, and do not add "client:".
QUESTLOG_LFG_API_URL=https://questlog.casual-heroes.com/api/v1/lfg
QUESTLOG_LFG_API_TOKEN=

# Controlled LFG migration switches. Enable canonical mode only after adding
# the scoped token. Keep legacy writes enabled during the observation window.
LFG_CANONICAL_API_ENABLED=false
LFG_LEGACY_WRITES_ENABLED=true

# Compatibility only. The old monitor imports the website's Django runtime
# directly and overlaps with the dashboard-managed live alerts adapter.
# Keep disabled unless temporarily needed while migrating an old server.
ENABLE_LEGACY_STREAMING_MONITOR=false

# Compatibility only. QuestLog owns flair selection and Warden mirrors the
# selected flair into Discord through cogs.flair_sync.
ENABLE_LEGACY_DISCORD_FLAIR_STORE=false

# High-risk break-glass feature. When enabled, the bot owner can invoke
# allowlisted sudo/systemctl actions from Discord. Prefer host-side incident
# response and leave this disabled during normal operation.
ENABLE_EMERGENCY_SERVICE_CONTROL=false

# Compatibility only. This legacy tracker reads site tables synchronously and
# writes JSON into the website repository. Replace it with a scoped API before
# disabling it. It remains enabled during the compatibility window.
ENABLE_LEGACY_SITE_ACTIVITY_EXPORT=true

# QuestLog authoritative progression API. Use a separate token containing only
# the progression:write scope. Warden reports evidence; QuestLog calculates XP.
QUESTLOG_PROGRESSION_API_URL=https://questlog.casual-heroes.com/api/v1/progression/events
QUESTLOG_PROGRESSION_API_TOKEN=
QUESTLOG_PROGRESSION_API_ENABLED=false

# ─── Legacy queue safety and audit privacy ───────────────────────────────────
# Ambiguous processing jobs older than this are marked failed with a quarantine
# reason on startup. They are never automatically replayed.
LEGACY_ACTION_QUARANTINE_AFTER_SECONDS=3600

# Audit metadata is bounded by default. Deleted-message bodies are not stored
# unless a community has been given notice and this explicit opt-in is enabled.
AUDIT_RETENTION_DAYS=90
# Approved policy: automatically remove audit metadata after this window.
AUDIT_RETENTION_ENFORCEMENT_ENABLED=true
AUDIT_DELETED_CONTENT_ENABLED=false
AUDIT_DELETED_CONTENT_RETENTION_DAYS=7

# ─── Twitch / IGDB API (Game Discovery) ──────────────────────────────────────
# Get credentials at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Bot Owner & Access Control ──────────────────────────────────────────────
# Discord user ID of the bot owner (enables /emergency commands)
BOT_OWNER_ID=
# Comma-separated Discord user IDs allowed to approve Discovery Network communities
DISCOVERY_APPROVERS=

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=production

# For development: restrict slash commands to one guild for faster sync
# DEBUG_GUILD_ID=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_PATH=.
LOG_LEVEL=INFO

# ─── Emergency Kill Switch ────────────────────────────────────────────────────
# Path to the Django maintenance flag file (must match ch-webserver config)
MAINTENANCE_FLAG_PATH=/srv/ch-webserver/.maintenance
# systemd service names (adjust if yours differ)
EMERGENCY_WEB_SERVICE=casualheroes
EMERGENCY_MATRIX_SERVICE=matrix-synapse
# Optional: Discord channel ID to log emergency actions (0 to disable)
EMERGENCY_AUDIT_CHANNEL_ID=0

# ─── AMP Game Server Panel (optional) ────────────────────────────────────────
# AMP_URL=http://your-amp-host:8080
# AMP_USER=
# AMP_PASSWORD=
